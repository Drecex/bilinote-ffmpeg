installer/ffmpeg/
*.exe

# 笔记 / 使用记录（绝不提交）
note_results/
uploads/
logs/
*.db
*.sqlite*
static/screenshots/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
